    {
        "id": "f911248429c14917",
        "type": "function",
        "z": "956c639306302d03",
        "name": "CSV Row Formatter",
        "func": "// Get processed sensor data\nlet data = msg.payload;\n\n// Validate required values\nif (\n    !data ||\n    typeof data.temperature !== \"number\" ||\n    typeof data.humidity !== \"number\"\n) {\n    node.warn(\"Invalid data for CSV logging\");\n    return null;\n}\n\n// Prepare CSV columns\nlet timestamp = data.timestamp || new Date().toISOString();\n\nlet temperature = data.temperature.toFixed(2);\nlet humidity = data.humidity.toFixed(2);\n\nlet heater = data.heater ? \"ON\" : \"OFF\";\nlet fan = data.fan ? \"ON\" : \"OFF\";\nlet mode = data.mode || \"AUTO\";\n\n// Create one CSV row\nmsg.payload = [\n    timestamp,\n    temperature,\n    humidity,\n    heater,\n    fan,\n    mode\n].join(\",\");;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 820,
        "wires": [
