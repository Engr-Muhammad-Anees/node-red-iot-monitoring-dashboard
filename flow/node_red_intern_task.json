    {
        "id": "1c3c4b93303f5a0a",
        "type": "function",
        "z": "956c639306302d03",
        "name": "Critical Temperature Alarm",
        "func": "\nlet temperature = msg.payload.temperature;\n\n// Validate temperature\nif (typeof temperature !== \"number\") {\n    node.warn(\"Invalid temperature for critical alarm\");\n    return null;\n}\n\n// Check critical temperature\nlet alarmActive = temperature > 40;\n\n// Get previous alarm state\nlet previousAlarm = context.get(\"criticalAlarm\") || false;\n\n// Warn only when alarm changes state\nif (alarmActive && !previousAlarm) {\n    node.warn(\"CRITICAL ALERT! Temperature is above 40°C\");\n}\n\nif (!alarmActive && previousAlarm) {\n    node.warn(\"Temperature is back to normal. Alarm cleared.\");\n}\n\n// Save alarm state\ncontext.set(\"criticalAlarm\", alarmActive);\n\n// Prepare dashboard message\nmsg.payload = alarmActive\n    ? \"CRITICAL ALERT! Temperature: \" + temperature + \" °C\"\n    : \"Normal - Temperature: \" + temperature + \" °C\";\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 760,
