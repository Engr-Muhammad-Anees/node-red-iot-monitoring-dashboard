        "id": "028aa30a4d720a42",
        "type": "function",
        "z": "956c639306302d03",
        "name": "Generate Sensor Data",
        "func": "// Generate random temperature between 20 and 45\nlet temperature = Number((20 + Math.random() * 25).toFixed(2));\n\n// Generate random humidity between 30 and 90\nlet humidity = Number((30 + Math.random() * 60).toFixed(2));\n\n// Create sensor data\nmsg.payload = {\n    temperature: temperature,\n    humidity: humidity,\n    timestamp: new Date().toISOString()\n};\n\n// Return message\nreturn msg;",
