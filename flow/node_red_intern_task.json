        "func": "let temperature = msg.payload.temperature;\n\nlet status;\n\nif (temperature < 35) {\n    status = \"LOW\";\n} \nelse if (temperature <= 38) {\n    status = \"NORMAL\";\n} \nelse {\n    status = \"HIGH\";\n}\n\nmsg.payload = status;\n\nreturn msg;",
