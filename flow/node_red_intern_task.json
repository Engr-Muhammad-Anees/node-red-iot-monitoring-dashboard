    {
        "id": "e3dafc9a0cf0e43b",
        "type": "function",
        "z": "956c639306302d03",
        "name": "Automatic Control Logic",
        "func": "// Get temperature from MQTT data\nlet temperature = msg.payload.temperature;\n\n// Set automatic heater and fan states\nlet heater = false;\nlet fan = false;\n\nif (temperature < 35) {\n    heater = true;\n    fan = false;\n}\nelse if (temperature > 38) {\n    heater = false;\n    fan = true;\n}\n\n// Prepare control information\nmsg.payload = {\n    temperature: temperature,\n    heater: heater,\n    fan: fan,\n    mode: \"AUTO\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 360,
        "wires": [
