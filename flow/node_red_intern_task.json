    {
        "id": "698ac9212424c0c9",
        "type": "function",
        "z": "956c639306302d03",
        "name": "Device State Manager",
        "func": "\n// Get previously saved device state\nlet state = context.get(\"deviceState\") || {\n    mode: \"AUTO\",\n    temperature: null,\n    humidity: null,\n    timestamp: null,\n    heater: false,\n    fan: false\n};\n\n// ----------------------------------\n// 1. HANDLE MODE SELECTION\n// ----------------------------------\n\nif (msg.topic === \"mode/set\") {\n\n    let selectedMode = msg.payload;\n\n    if (selectedMode !== \"AUTO\" && selectedMode !== \"MANUAL\") {\n        node.warn(\"Invalid operating mode\");\n        return null;\n    }\n\n    state.mode = selectedMode;\n\n    // Recalculate devices when returning to AUTO\n    if (state.mode === \"AUTO\" && state.temperature !== null) {\n\n        if (state.temperature < 35) {\n            state.heater = true;\n            state.fan = false;\n        }\n        else if (state.temperature > 38) {\n            state.heater = false;\n            state.fan = true;\n        }\n        else {\n            state.heater = false;\n            state.fan = false;\n        }\n    }\n}\n\n// ----------------------------------\n// 2. HANDLE MANUAL HEATER CONTROL\n// ----------------------------------\n\nelse if (msg.topic === \"heater/set\") {\n\n    if (state.mode !== \"MANUAL\") {\n        node.warn(\"Switch to MANUAL mode to control Heater\");\n        return null;\n    }\n\n    if (typeof msg.payload !== \"boolean\") {\n        node.warn(\"Invalid Heater command\");\n        return null;\n    }\n\n    state.heater = msg.payload;\n}\n\n// ----------------------------------\n// 3. HANDLE MANUAL FAN CONTROL\n// ----------------------------------\n\nelse if (msg.topic === \"fan/set\") {\n\n    if (state.mode !== \"MANUAL\") {\n        node.warn(\"Switch to MANUAL mode to control Fan\");\n        return null;\n    }\n\n    if (typeof msg.payload !== \"boolean\") {\n        node.warn(\"Invalid Fan command\");\n        return null;\n    }\n\n    state.fan = msg.payload;\n}\n\n// ----------------------------------\n// 4. HANDLE SENSOR READINGS\n// ----------------------------------\n\nelse {\n\n    let data = msg.payload;\n\n    if (typeof data === \"string\") {\n        try {\n            data = JSON.parse(data);\n        } catch (err) {\n            node.warn(\"Invalid JSON sensor data\");\n            return null;\n        }\n    }\n\n    if (\n        !data ||\n        typeof data.temperature !== \"number\" ||\n        typeof data.humidity !== \"number\"\n    ) {\n        node.warn(\"Invalid sensor readings\");\n        return null;\n    }\n\n    state.temperature = data.temperature;\n    state.humidity = data.humidity;\n\n    // Save sensor timestamp\n    state.timestamp = data.timestamp || new Date().toISOString();\n\n    // Automatic control only in AUTO mode\n    if (state.mode === \"AUTO\") {\n\n        if (state.temperature < 35) {\n            state.heater = true;\n            state.fan = false;\n        }\n        else if (state.temperature > 38) {\n            state.heater = false;\n            state.fan = true;\n        }\n        else {\n            state.heater = false;\n            state.fan = false;\n        }\n    }\n}\n\n// ----------------------------------\n// 5. SAVE UPDATED STATE\n// ----------------------------------\n\ncontext.set(\"deviceState\", state);\n\n// ----------------------------------\n// 6. SEND CURRENT STATE TO DASHBOARD\n// ----------------------------------\n\nmsg.payload = {\n    temperature: state.temperature,\n    humidity: state.humidity,\n    timestamp: state.timestamp,\n    heater: state.heater,\n    fan: state.fan,\n    mode: state.mode\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 720,
        "wires": [
